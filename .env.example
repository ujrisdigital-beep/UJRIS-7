DATABASE_URL="file:./dev.db"

# Session signing secret. In production this MUST be set to a long random
# value via a real secret manager / environment variable. There is no
# fallback in production - the app refuses to boot without it.
AUTH_SECRET="replace-with-a-long-random-value"

# --- AI Gateway (optional) ---
# If unset, UJRIS falls back to its deterministic heuristic engine for
# signal extraction, contradiction flags and drafting. Add a key to route
# through a real model without changing any application code.
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Billing ---
# Paid plans require Stripe. Missing Stripe configuration NEVER grants a paid
# plan. Local simulation is allowed only when NODE_ENV is not production AND
# UJRIS_ALLOW_DEV_BILLING=true. That flag is ignored in production.
# UJRIS_ALLOW_DEV_BILLING=true
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PROTECT=
# STRIPE_PRICE_ADVOCATE=

NEXT_PUBLIC_APP_URL="http://localhost:4127"
